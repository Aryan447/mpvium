---
import { getCollection, render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { links } from "../data/site";

const [entry] = await getCollection("doctrine");
if (!entry) {
  throw new Error("DOCTRINE.md not found at the repository root.");
}
const { Content } = await render(entry);
---

<BaseLayout
  active="doctrine"
  title="Doctrine — mpvium"
  description="The rules mpvium is built against: sane defaults, pro-level control, playback fidelity, privacy, efficiency, and honesty about what changed."
>
  <article class="doctrine mx-auto max-w-3xl px-5 pb-2 pt-14">
    <Content />
  </article>

  <p class="mx-auto max-w-3xl px-5 pb-12 pt-8 text-sm text-[var(--muted)]">
    Generated from <code class="font-mono text-[13px]">DOCTRINE.md</code> at build time.{" "}
    <a class="font-semibold text-[var(--primary)] hover:underline" href={links.doctrineFile}>
      Read the file ↗
    </a>
  </p>

  <script is:inline>
    // Every heading already has a slug id, so /doctrine/#sane-defaults-are-the-product
    // works as-is. Add a visible link icon so the anchor is discoverable and copyable.
    (function () {
      var icon =
        '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.07 0l1.42-1.42a5 5 0 0 0-7.07-7.07L10 5.93"/><path d="M14 11a5 5 0 0 0-7.07 0L5.51 12.4a5 5 0 0 0 7.07 7.07L14 18.07"/></svg>';

      document.querySelectorAll(".doctrine h2[id]").forEach(function (heading) {
        var link = document.createElement("a");
        link.className = "heading-anchor";
        link.href = "#" + heading.id;
        link.setAttribute("aria-label", "Link to " + heading.textContent.trim());
        link.innerHTML = icon;
        heading.appendChild(link);
      });
    })();
  </script>
</BaseLayout>

<style>
  /* Styles reach into the rendered markdown, so they are global. */

  .doctrine :global(h1) {
    font-size: 2.25rem;
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .doctrine :global(h1)::after {
    content: ".";
    color: var(--primary);
  }

  .doctrine :global(h1 + p) {
    margin-top: 0.75rem;
    color: var(--muted);
    font-size: 1.0625rem;
  }

  .doctrine :global(h2) {
    margin-top: 2.75rem;
    border-top: 1px solid var(--border);
    padding-top: 1.75rem;
    font-size: 1.5rem;
    font-weight: 800;
    letter-spacing: -0.01em;
    line-height: 1.25;
    text-wrap: balance;
    /* Keep a shared #anchor clear of the sticky header. */
    scroll-margin-top: 5rem;
  }

  .doctrine :global(.heading-anchor) {
    display: inline-flex;
    margin-left: 0.4rem;
    vertical-align: 0.1em;
    color: var(--primary);
    opacity: 0.35;
    transition: opacity 0.15s;
  }

  .doctrine :global(h2:hover .heading-anchor),
  .doctrine :global(.heading-anchor:focus-visible) {
    opacity: 1;
  }

  .doctrine :global(.heading-anchor svg) {
    width: 0.75em;
    height: 0.75em;
  }

  .doctrine :global(p),
  .doctrine :global(ul),
  .doctrine :global(ol),
  .doctrine :global(blockquote) {
    margin-top: 0.85rem;
    color: var(--muted);
    line-height: 1.7;
  }

  .doctrine :global(ul),
  .doctrine :global(ol) {
    padding-left: 1.25rem;
  }

  .doctrine :global(ul) {
    list-style: disc;
  }

  .doctrine :global(ol) {
    list-style: decimal;
  }

  .doctrine :global(li) {
    margin-top: 0.4rem;
  }

  .doctrine :global(li)::marker {
    color: var(--primary);
  }

  .doctrine :global(strong) {
    color: var(--text);
    font-weight: 650;
  }

  .doctrine :global(a) {
    color: var(--primary);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .doctrine :global(code) {
    border: 1px solid var(--border);
    border-radius: 0.375rem;
    background: var(--surface2);
    padding: 0.1rem 0.35rem;
    font-size: 0.875em;
  }

  .doctrine :global(blockquote) {
    border-left: 2px solid var(--primary);
    padding-left: 1rem;
    color: var(--text);
  }

  .doctrine :global(hr) {
    margin: 2.5rem 0 1.25rem;
    border: 0;
    border-top: 1px solid var(--border);
  }

  .doctrine :global(hr + p) {
    font-size: 0.95rem;
  }
</style>
