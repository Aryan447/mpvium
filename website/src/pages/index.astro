---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import FeatureGrid from "../components/FeatureGrid.astro";
import ThemeSwitcher from "../components/ThemeSwitcher.astro";
import { features } from "../data/features";
import { shots } from "../data/screenshots";
import { links } from "../data/site";
---

<BaseLayout active="home">
  <Hero />

  <div class="film-strip"></div>

  <section class="mx-auto max-w-5xl px-5 pb-2 pt-14" aria-labelledby="features-h">
    <h2 id="features-h" class="mb-1.5 text-[28px] font-extrabold tracking-[-0.5px]">
      Features<span class="text-[var(--primary)]">.</span>
    </h2>
    <p class="mb-6 text-[var(--muted)]">Everything you need up front, nothing in your way.</p>
    <FeatureGrid features={features} />
    <p class="mt-5">
      <a href="/features" class="font-bold text-[var(--primary)] hover:underline">
        Explore all features →
      </a>
    </p>
  </section>

  <section class="mx-auto max-w-5xl px-5 pb-2 pt-14" aria-labelledby="shots-h">
    <h2 id="shots-h" class="mb-1.5 text-[28px] font-extrabold tracking-[-0.5px]">
      Screenshots<span class="text-[var(--primary)]">.</span>
    </h2>
    <p class="mb-6 text-[var(--muted)]">Library, browsing, playback — dark default theme.</p>
    <div class="grid gap-3.5 sm:grid-cols-2 lg:grid-cols-4">
      {
        shots.slice(0, 4).map((s) => (
          <div class="rounded-2xl border border-[var(--border)] bg-[var(--surface)] p-2">
            <img
              src={s.src}
              alt={s.alt}
              loading="lazy"
              class="w-full rounded-[10px]"
            />
            <h3 class="mb-0.5 mt-2 px-2 text-base font-bold text-[var(--primary)]">{s.title}</h3>
            <p class="px-2 pb-2 text-sm text-[var(--muted)]">{s.caption}</p>
          </div>
        ))
      }
    </div>
    <p class="mt-5">
      <a href="/screenshots" class="font-bold text-[var(--primary)] hover:underline">
        View gallery →
      </a>
    </p>
  </section>

  <section class="mx-auto max-w-5xl px-5 pb-2 pt-14" aria-labelledby="themes-h">
    <h2 id="themes-h" class="mb-1.5 text-[28px] font-extrabold tracking-[-0.5px]">
      Themes<span class="text-[var(--primary)]">.</span>
    </h2>
    <p class="mb-6 text-[var(--muted)]">
      Four grades. Pick one — this whole page re-skins like the app.
    </p>
    <ThemeSwitcher />
  </section>

  <section class="mx-auto max-w-5xl px-5 pb-2 pt-14" aria-labelledby="cta-h">
    <div
      class="rounded-2xl border border-[var(--border)] bg-[var(--surface)] p-8 text-center"
    >
      <h2 id="cta-h" class="text-2xl font-extrabold">
        Ready to watch<span class="text-[var(--primary)]">?</span>
      </h2>
      <p class="mx-auto mt-2 max-w-xl text-[var(--muted)]">
        Grab the latest APK from GitHub Releases, or follow development in the Telegram
        community.
      </p>
      <div class="mt-5 flex flex-wrap justify-center gap-3">
        <a
          href="/download"
          class="inline-block rounded-full bg-[var(--primary)] px-7 py-3 text-base font-bold text-[#1A1206] hover:brightness-110"
        >
          Get mpvium
        </a>
        <a
          href={links.telegram}
          class="inline-block rounded-full border border-[var(--border)] px-7 py-3 text-base font-bold text-[var(--text)] hover:border-[var(--primary)]"
        >
          Join Telegram
        </a>
      </div>
    </div>
  </section>
  <div class="h-6"></div>
</BaseLayout>
