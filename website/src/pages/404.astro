---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="404 — mpvium" description="Page not found.">
  <div class="mx-auto max-w-3xl px-5 py-24 text-center">
    <p class="text-6xl font-extrabold text-[var(--primary)]">404</p>
    <h1 class="mt-4 text-2xl font-extrabold">This reel is missing.</h1>
    <p class="mt-2 text-[var(--muted)]">The page you&apos;re looking for doesn&apos;t exist.</p>
    <a
      href="/"
      class="mt-6 inline-block rounded-full bg-[var(--primary)] px-7 py-3 text-base font-bold text-[#1A1206] hover:brightness-110"
    >
      Back home
    </a>
  </div>
</BaseLayout>
