---
import BaseLayout from "../layouts/BaseLayout.astro";
import FeatureGrid from "../components/FeatureGrid.astro";
import { features, moreFeatures } from "../data/features";
---

<BaseLayout
  active="features"
  title="Features — mpvium"
  description="Everything mpvium does: mpv-powered playback, Material 3 UI, PiP, background audio, network streaming, subtitles, and pro-level config."
>
  <div class="mx-auto max-w-5xl px-5 pb-2 pt-14">
    <h1 class="text-4xl font-extrabold tracking-tight">
      Features<span class="text-[var(--primary)]">.</span>
    </h1>
    <p class="mb-8 mt-2 text-[var(--muted)]">
      Sane defaults up front, pro-level control when you want it.
    </p>

    <FeatureGrid features={features} />

    <h2 class="mb-3 mt-12 text-2xl font-extrabold">
      And more<span class="text-[var(--primary)]">.</span>
    </h2>
    <ul class="grid gap-3 sm:grid-cols-2">
      {
        moreFeatures.map((f) => (
          <li class="rounded-2xl border border-[var(--border)] bg-[var(--surface)] px-5 py-4 text-[15px]">
            <span class="mr-2 text-[var(--primary)]" aria-hidden="true">✓</span>
            {f}
          </li>
        ))
      }
    </ul>
  </div>
  <div class="h-10"></div>
</BaseLayout>
