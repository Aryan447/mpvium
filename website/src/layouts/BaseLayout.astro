---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { meta as siteMeta } from "../data/site";
import { defaultTheme } from "../data/themes";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  active?: string;
}

const { title = siteMeta.title, description = siteMeta.description, active } = Astro.props;
---

<!doctype html>
<html lang="en" data-theme={defaultTheme}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="/icon.png" />
    <meta name="theme-color" content="#0F0607" />
    <script is:inline>
      // Restore saved theme before paint to avoid a flash.
      try {
        var t = localStorage.getItem("mpvium-theme");
        if (t) document.documentElement.setAttribute("data-theme", t);
      } catch (e) {}
    </script>
  </head>
  <body class="min-h-screen antialiased">
    <Header active={active} />
    <main><slot /></main>
    <Footer />
  </body>
</html>
