---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { DEFAULT_LOCALE, getLocaleInfo, type LocaleCode } from "../i18n/locales";
import { getTranslations } from "../i18n";
import { defaultTheme } from "../data/themes";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  active?: string;
  locale?: LocaleCode;
  subPath?: string;
}

const {
  locale = DEFAULT_LOCALE,
  subPath = "/",
  active,
} = Astro.props;
const t = getTranslations(locale);
const localeInfo = getLocaleInfo(locale);
const {
  title = t.meta.title,
  description = t.meta.description,
} = Astro.props;
---

<!doctype html>
<html lang={localeInfo.htmlLang} dir={localeInfo.dir} data-theme={defaultTheme}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="/icon.png" />
    <meta name="theme-color" content="#0F0607" />
    <script is:inline>
      // Restore saved theme before paint to avoid a flash.
      try {
        var t = localStorage.getItem("mpvium-theme");
        if (t) document.documentElement.setAttribute("data-theme", t);
      } catch (e) {}
    </script>
  </head>
  <body class="min-h-screen antialiased">
    <Header active={active} locale={locale} subPath={subPath} />
    <main><slot /></main>
    <Footer locale={locale} />
  </body>
</html>
