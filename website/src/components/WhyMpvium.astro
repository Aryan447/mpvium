---
import { links } from "../data/site";
import { DEFAULT_LOCALE, type LocaleCode } from "../i18n/locales";
import { getTranslations } from "../i18n";

interface Props {
  locale?: LocaleCode;
}

const { locale = DEFAULT_LOCALE } = Astro.props;
const t = getTranslations(locale);

const engineIcons = [
  '<path d="M12 3s6 6.5 6 11a6 6 0 01-12 0c0-4.5 6-11 6-11z"/><path d="M9 14.5c.7 1.2 1.7 1.8 3 1.8"/>',
  '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 15l4-4 3 3 4-5 7 6"/><path d="M7 9h.01"/>',
  '<path d="M8 3H3v5M16 3h5v5M8 21H3v-5M16 21h5v-5"/><rect x="8" y="8" width="8" height="8" rx="1"/>',
  '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="M7 12h4M7 15h7M14 12h3"/>',
];

const engineBenefits = t.why.engineBenefits.map((b, i) => ({
  ...b,
  icon: engineIcons[i],
}));
---

<section class="mx-auto max-w-5xl px-5 pb-2 pt-14" aria-labelledby="why-h">
  <h2 id="why-h" class="mb-1.5 text-[28px] font-extrabold tracking-[-0.5px]">
    {t.why.heading}<span class="text-[var(--primary)]">?</span>
  </h2>
  <p class="max-w-3xl text-[var(--muted)]">
    {t.why.introPrefix}{" "}
    <span class="text-[var(--text)]">{t.why.introHighlight}</span>{" "}
    {t.why.introSuffix}
  </p>

  <div class="mt-6 grid gap-3.5 lg:grid-cols-3">
    <article class="rounded-2xl border border-[var(--border)] bg-[var(--surface)] p-[18px]">
      <p class="text-[11px] font-bold uppercase tracking-[0.14em] text-[var(--muted)]">
        {t.why.col1Eyebrow}
      </p>
      <h3 class="mt-1 text-lg font-extrabold">{t.why.col1Title}</h3>
      <p class="mt-1.5 text-sm text-[var(--muted)]">{t.why.col1Body}</p>
      <ul class="mt-4 space-y-2 text-sm text-[var(--muted)]">
        {t.why.col1Bullets.map((item) => <li>{item}</li>)}
      </ul>
    </article>

    <article class="rounded-2xl border border-[var(--primary)] bg-[var(--surface2)] p-[18px]">
      <p class="text-[11px] font-bold uppercase tracking-[0.14em] text-[var(--primary)]">
        {t.why.col2Eyebrow}
      </p>
      <h3 class="mt-1 text-lg font-extrabold text-[var(--primary)]">{t.why.col2Title}</h3>
      <p class="mt-1.5 text-sm text-[var(--text)]">{t.why.col2Body}</p>
      <ul class="mt-4 space-y-2 text-sm text-[var(--text)]">
        {
          t.why.col2Bullets.map((item) => (
            <li>
              <span class="me-1.5 text-[var(--primary)]" aria-hidden="true">✓</span>
              {item}
            </li>
          ))
        }
      </ul>
    </article>

    <article class="rounded-2xl border border-[var(--border)] bg-[var(--surface)] p-[18px]">
      <p class="text-[11px] font-bold uppercase tracking-[0.14em] text-[var(--muted)]">
        {t.why.col3Eyebrow}
      </p>
      <h3 class="mt-1 text-lg font-extrabold">{t.why.col3Title}</h3>
      <p class="mt-1.5 text-sm text-[var(--muted)]">{t.why.col3Body}</p>
      <ul class="mt-4 space-y-2 text-sm text-[var(--muted)]">
        {t.why.col3Bullets.map((item) => <li>{item}</li>)}
      </ul>
    </article>
  </div>

  <div class="mt-10">
    <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
      <h3 class="text-2xl font-extrabold tracking-[-0.3px]">
        {t.why.engineHeading}<span class="text-[var(--primary)]">.</span>
      </h3>
      <a
        class="text-sm font-bold text-[var(--primary)] hover:underline"
        href={links.mpvRocks}
      >
        {t.why.engineCompare}
      </a>
    </div>
    <p class="mt-1 max-w-3xl text-sm text-[var(--muted)]">
      {t.why.engineBody}
    </p>

    <div class="mt-4 grid gap-3.5 sm:grid-cols-2 lg:grid-cols-4">
      {
        engineBenefits.map((b) => (
          <div class="rounded-2xl border border-[var(--border)] bg-[var(--surface)] p-[18px]">
            <svg
              viewBox="0 0 24 24"
              class="h-[26px] w-[26px] fill-none stroke-[var(--tertiary)]"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              set:html={b.icon}
            />
            <h4 class="mb-1 mt-2.5 text-base font-bold text-[var(--primary)]">{b.title}</h4>
            <p class="text-sm text-[var(--muted)]">{b.description}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
