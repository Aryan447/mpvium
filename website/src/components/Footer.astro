---
import { links } from "../data/site";
import { DEFAULT_LOCALE, localePath, type LocaleCode } from "../i18n/locales";
import { getTranslations } from "../i18n";

interface Props {
  locale?: LocaleCode;
}

const { locale = DEFAULT_LOCALE } = Astro.props;
const t = getTranslations(locale);
---

<footer class="px-5 pb-14 pt-12 text-center text-sm text-[var(--muted)]">
  <div class="mx-auto max-w-5xl">
    <p>
      mpvium · <a class="text-[var(--primary)] hover:underline" href={links.github}>GitHub</a>
      {" · "}
      <a class="text-[var(--primary)] hover:underline" href={links.releases}>{t.footer.releases}</a>
      {" · "}
      <a class="text-[var(--primary)] hover:underline" href={localePath(locale, "/doctrine")}>{t.footer.doctrine}</a>
      {" · "}
      <a class="text-[var(--primary)] hover:underline" href={links.discord}>Discord</a>
      {" · "}
      <a class="text-[var(--primary)] hover:underline" href={links.telegram}>Telegram</a>
      {" · "}
      <a class="text-[var(--primary)] hover:underline" href={links.reddit}>Reddit</a>
      {" · GPL-3.0-or-later"}
    </p>
    <p class="mt-2">{t.footer.abiNote}</p>
  </div>
</footer>
