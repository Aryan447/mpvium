---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { links } from "../../data/site";
import { DEFAULT_LOCALE, type LocaleCode } from "../../i18n/locales";
import { getTranslations } from "../../i18n";

interface Props {
  locale?: LocaleCode;
}

const { locale = DEFAULT_LOCALE } = Astro.props;
const t = getTranslations(locale);
---

<BaseLayout
  active="download"
  locale={locale}
  subPath="/download"
  title={t.meta.downloadTitle}
  description={t.meta.downloadDescription}
>
  <div class="mx-auto max-w-3xl px-5 pb-2 pt-14 text-center">
    <h1 class="text-4xl font-extrabold tracking-tight">
      {t.downloadPage.heading}<span class="text-[var(--primary)]">.</span>
    </h1>
    <p class="mx-auto mb-8 mt-2 max-w-xl text-[var(--muted)]">
      {t.downloadPage.subtitle}
    </p>

    <div class="flex flex-wrap justify-center gap-3">
      <a
        id="dl-stable"
        href={links.latestRelease}
        class="inline-block w-full rounded-full bg-[var(--primary)] px-5 py-3.5 text-base font-bold text-[#1A1206] hover:brightness-110 sm:w-auto sm:px-7"
      >
        {t.hero.downloadStable}
      </a>
      <a
        id="dl-preview"
        aria-disabled="true"
        class="inline-block w-full cursor-not-allowed rounded-full border border-[var(--border)] px-5 py-3.5 text-base font-bold text-[var(--text)] opacity-50 sm:w-auto sm:px-7"
      >
        {t.hero.checkingPreview}
      </a>
    </div>
    <p id="dl-meta" class="mt-3 text-[13px] text-[var(--muted)]">{t.hero.resolvingVersions}</p>

    <div class="mt-10 text-start">
      <div class="overflow-hidden rounded-2xl border border-[var(--border)] sm:hidden">
        <div class="bg-[var(--surface2)] px-4 py-3 text-sm font-bold">{t.downloadPage.tableHeading}</div>
        {
          t.downloadPage.apks.map((row) => (
            <div class="border-t border-[var(--border)] bg-[var(--surface)] px-4 py-3">
              <div class="font-mono text-[13px] font-semibold text-[var(--primary)]">
                {row.file}
              </div>
              <div class="mt-0.5 text-sm text-[var(--muted)]">{row.devices}</div>
            </div>
          ))
        }
      </div>

      <div class="hidden overflow-hidden rounded-2xl border border-[var(--border)] sm:block">
        <table class="w-full text-sm">
          <thead>
            <tr class="bg-[var(--surface2)] text-start">
              <th class="px-5 py-3 font-bold">{t.downloadPage.colApk}</th>
              <th class="px-5 py-3 font-bold">{t.downloadPage.colDevices}</th>
            </tr>
          </thead>
          <tbody>
            {
              t.downloadPage.apks.map((row) => (
                <tr class="border-t border-[var(--border)] bg-[var(--surface)]">
                  <td class="px-5 py-3 font-mono text-[13px] text-[var(--primary)]">{row.file}</td>
                  <td class="px-5 py-3 text-[var(--muted)]">{row.devices}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>

    <p class="mt-6 text-sm text-[var(--muted)]">
      {t.downloadPage.footerPrefix}{" "}
      <a class="text-[var(--primary)] hover:underline" href={links.releases}>
        {t.downloadPage.footerRelease}
      </a>
      {t.downloadPage.footerMiddle}{" "}
      <a class="text-[var(--primary)] hover:underline" href={links.github}>
        {t.downloadPage.footerReadme}
      </a>
      {t.downloadPage.footerSuffix}
    </p>
  </div>
  <div class="h-10"></div>
</BaseLayout>

<script
  is:inline
  data-repo="aryan447/mpvium"
  data-stable-tpl={t.hero.downloadStableTag}
  data-preview-tpl={t.hero.downloadPreviewTag}
  data-no-preview={t.hero.noPreview}
  data-latest-meta={t.hero.latestMeta}
  data-unavailable={t.hero.releasesUnavailable}
>
  (function () {
    var script = document.currentScript;
    var repo = script.getAttribute("data-repo");
    var stableTpl = script.getAttribute("data-stable-tpl") || "Download Stable {tag} (arm64-v8a)";
    var previewTpl = script.getAttribute("data-preview-tpl") || "Download Preview {tag} (arm64-v8a)";
    var noPreviewLabel = script.getAttribute("data-no-preview") || "No preview build";
    var latestMetaTpl = script.getAttribute("data-latest-meta") || "Latest: {parts}";
    var unavailableLabel = script.getAttribute("data-unavailable") || "Releases available on GitHub.";

    var stableBtn = document.getElementById("dl-stable");
    var previewBtn = document.getElementById("dl-preview");
    var meta = document.getElementById("dl-meta");
    if (!stableBtn || !previewBtn || !meta) return;

    function arm64Apk(assets) {
      if (!assets) return null;
      for (var i = 0; i < assets.length; i++) {
        var n = assets[i].name || "";
        if (n.indexOf("arm64-v8a") !== -1 && n.slice(-4) === ".apk") return assets[i];
      }
      return null;
    }

    function setBtn(btn, asset) {
      if (asset) {
        btn.href = asset.browser_download_url;
        btn.setAttribute("download", asset.name);
        return asset.name;
      }
      return null;
    }

    function setPreviewDisabled(label) {
      previewBtn.removeAttribute("href");
      previewBtn.removeAttribute("download");
      previewBtn.setAttribute("aria-disabled", "true");
      previewBtn.classList.add("cursor-not-allowed", "opacity-50");
      previewBtn.classList.remove("hover:border-[var(--primary)]");
      previewBtn.textContent = label;
    }

    function setPreviewEnabled(asset, tag) {
      previewBtn.href = asset.browser_download_url;
      previewBtn.setAttribute("download", asset.name);
      previewBtn.removeAttribute("aria-disabled");
      previewBtn.classList.remove("cursor-not-allowed", "opacity-50");
      previewBtn.classList.add("hover:border-[var(--primary)]");
      previewBtn.textContent = previewTpl.replace("{tag}", tag);
    }

    Promise.all([
      fetch("https://api.github.com/repos/" + repo + "/releases/latest")
        .then(function (r) { return r.ok ? r.json() : null; })
        .catch(function () { return null; }),
      fetch("https://api.github.com/repos/" + repo + "/releases?per_page=20")
        .then(function (r) { return r.ok ? r.json() : null; })
        .catch(function () { return null; }),
    ])
      .then(function (res) {
        var stable = res[0], list = res[1], sName = null, pName = null;
        if (stable) {
          var a = arm64Apk(stable.assets);
          sName = setBtn(stableBtn, a);
          if (a) stableBtn.textContent = stableTpl.replace("{tag}", stable.tag_name);
        }
        if (list) {
          for (var i = 0; i < list.length; i++) {
            if (list[i].prerelease) {
              var pa = arm64Apk(list[i].assets);
              if (pa) {
                setPreviewEnabled(pa, list[i].tag_name);
                pName = pa.name;
                break;
              }
            }
          }
        }
        if (!pName) setPreviewDisabled(noPreviewLabel);
        var parts = [];
        if (sName) parts.push(sName);
        if (pName) parts.push(pName);
        meta.textContent = parts.length
          ? latestMetaTpl.replace("{parts}", parts.join(" · "))
          : unavailableLabel;
      })
      .catch(function () {
        setPreviewDisabled(noPreviewLabel);
        meta.textContent = unavailableLabel;
      });
  })();
</script>
