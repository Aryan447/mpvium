---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { shots } from "../../data/screenshots";
import { links } from "../../data/site";
import { DEFAULT_LOCALE, type LocaleCode } from "../../i18n/locales";
import { getTranslations } from "../../i18n";

interface Props {
  locale?: LocaleCode;
}

const { locale = DEFAULT_LOCALE } = Astro.props;
const t = getTranslations(locale);

const localizedShots = shots.map((s, i) => ({
  ...s,
  alt: t.screenshotsPage.shots[i]?.alt ?? s.alt,
  title: t.screenshotsPage.shots[i]?.title ?? s.title,
  caption: t.screenshotsPage.shots[i]?.caption ?? s.caption,
}));
---

<BaseLayout
  active="screenshots"
  locale={locale}
  subPath="/screenshots"
  title={t.meta.screenshotsTitle}
  description={t.meta.screenshotsDescription}
>
  <div class="mx-auto max-w-5xl px-5 pb-2 pt-14">
    <h1 class="text-4xl font-extrabold tracking-tight">
      {t.screenshotsPage.heading}<span class="text-[var(--primary)]">.</span>
    </h1>
    <p class="mb-8 mt-2 text-[var(--muted)]">
      {t.screenshotsPage.subtitle}
    </p>

    <div class="grid gap-3.5 sm:grid-cols-2 lg:grid-cols-3">
      {
        localizedShots.map((s) => (
          <figure
            class:list={[
              "overflow-hidden rounded-2xl border border-[var(--border)] bg-[var(--surface)]",
              s.wide && "sm:col-span-2 lg:col-span-3",
            ]}
          >
            <img
              src={s.src}
              alt={s.alt}
              loading="lazy"
              class="w-full"
            />
            <figcaption class="px-4 py-3">
              <b class="text-[15px] text-[var(--primary)]">{s.title}</b>
              <span class="block text-sm text-[var(--muted)]">{s.caption}</span>
            </figcaption>
          </figure>
        ))
      }
    </div>

    <p class="mt-6 text-sm text-[var(--muted)]">
      {t.screenshotsPage.morePrefix}{" "}
      <a class="text-[var(--primary)] hover:underline" href={links.screenshotsDir}>
        {t.screenshotsPage.moreLink}
      </a>{" "}
      {t.screenshotsPage.moreSuffix}
    </p>
  </div>
  <div class="h-10"></div>
</BaseLayout>
