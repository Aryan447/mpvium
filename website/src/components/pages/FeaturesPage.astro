---
import BaseLayout from "../../layouts/BaseLayout.astro";
import FeatureGrid from "../FeatureGrid.astro";
import { features } from "../../data/features";
import { DEFAULT_LOCALE, type LocaleCode } from "../../i18n/locales";
import { getTranslations } from "../../i18n";

interface Props {
  locale?: LocaleCode;
}

const { locale = DEFAULT_LOCALE } = Astro.props;
const t = getTranslations(locale);

const localizedFeatures = features.map((f, i) => ({
  ...f,
  title: t.featuresPage.items[i]?.title ?? f.title,
  description: t.featuresPage.items[i]?.description ?? f.description,
}));
---

<BaseLayout
  active="features"
  locale={locale}
  subPath="/features"
  title={t.meta.featuresTitle}
  description={t.meta.featuresDescription}
>
  <div class="mx-auto max-w-5xl px-5 pb-2 pt-14">
    <h1 class="text-4xl font-extrabold tracking-tight">
      {t.featuresPage.heading}<span class="text-[var(--primary)]">.</span>
    </h1>
    <p class="mb-8 mt-2 text-[var(--muted)]">
      {t.featuresPage.subtitle}
    </p>

    <FeatureGrid features={localizedFeatures} />

    <h2 class="mb-3 mt-12 text-2xl font-extrabold">
      {t.featuresPage.andMore}<span class="text-[var(--primary)]">.</span>
    </h2>
    <ul class="grid gap-3 sm:grid-cols-2">
      {
        t.featuresPage.moreItems.map((f) => (
          <li class="rounded-2xl border border-[var(--border)] bg-[var(--surface)] px-5 py-4 text-[15px]">
            <span class="me-2 text-[var(--primary)]" aria-hidden="true">✓</span>
            {f}
          </li>
        ))
      }
    </ul>
  </div>
  <div class="h-10"></div>
</BaseLayout>
