---
import BaseLayout from "../../layouts/BaseLayout.astro";
import InlineText from "../InlineText.astro";
import { changelog } from "../../data/changelog";
import { links } from "../../data/site";
import { DEFAULT_LOCALE, type LocaleCode } from "../../i18n/locales";
import { getTranslations } from "../../i18n";

interface Props {
  locale?: LocaleCode;
}

const { locale = DEFAULT_LOCALE } = Astro.props;
const t = getTranslations(locale);
---

<BaseLayout
  active="changelog"
  locale={locale}
  subPath="/changelog"
  title={t.meta.changelogTitle}
  description={t.meta.changelogDescription}
>
  <div class="mx-auto max-w-3xl px-5 pb-2 pt-14">
    <h1 class="text-4xl font-extrabold tracking-tight">
      {t.changelogPage.heading}<span class="text-[var(--primary)]">.</span>
    </h1>
    <p class="mb-8 mt-2 text-[var(--muted)]">
      {t.changelogPage.subtitlePrefix}{" "}
      <a class="text-[var(--primary)] hover:underline" href={links.releases}>
        {t.changelogPage.subtitleLink}
      </a>
      {t.changelogPage.subtitleSuffix}
    </p>

    {
      changelog.length === 0 ? (
        <p class="rounded-2xl border border-[var(--border)] bg-[var(--surface)] p-4 text-[var(--muted)] sm:p-6">
          {t.changelogPage.empty}
        </p>
      ) : (
        changelog.map((entry) => (
          <section class="mb-8 rounded-2xl border border-[var(--border)] bg-[var(--surface)] p-4 sm:p-6">
            <h2 class="text-xl font-extrabold text-[var(--primary)]">{entry.version}</h2>
            {entry.groups.map((group) => (
              <div class="mt-5 first:mt-3">
                {group.heading && (
                  <h3 class="text-sm font-bold uppercase tracking-wider text-[var(--muted)]">
                    {group.heading}
                  </h3>
                )}
                {group.paragraphs.map((parts) => (
                  <p class="mt-3 break-words text-[15px] leading-relaxed text-[var(--text)]">
                    <InlineText parts={parts} />
                  </p>
                ))}
                {group.items.length > 0 && (
                  <ul class="mt-3 list-disc space-y-1.5 break-words ps-5 text-[15px]">
                    {group.items.map((parts) => (
                      <li>
                        <InlineText parts={parts} />
                      </li>
                    ))}
                  </ul>
                )}
                {group.images.length > 0 && (
                  <div class="mt-4 flex flex-wrap gap-3">
                    {group.images.map((image) => (
                      <img
                        src={image.src}
                        alt={image.alt}
                        width={image.width}
                        loading="lazy"
                        class={
                          image.width
                            ? "h-auto max-w-full rounded-xl border border-[var(--border)]"
                            : "h-auto w-full rounded-xl border border-[var(--border)]"
                        }
                      />
                    ))}
                  </div>
                )}
              </div>
            ))}
          </section>
        ))
      )
    }
  </div>
  <div class="h-10"></div>
</BaseLayout>
