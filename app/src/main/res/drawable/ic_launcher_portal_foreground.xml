<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Subtle ambient drop shadow beneath the open stroke -->
    <path
        android:pathData="M 32,28.5 L 69,50.5 Q 77,55.5 69,60.5 L 41,78.5 Q 34,82.5 34,74.5 L 34,46.5"
        android:strokeColor="#33000000"
        android:strokeWidth="8.2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- Main Portal Open-Stroke Play Triangle Glyph -->
    <path
        android:pathData="M 32,27 L 69,49 Q 77,54 69,59 L 41,77 Q 34,81 34,73 L 34,45"
        android:strokeWidth="8.2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="30"
                android:startY="26"
                android:endX="78"
                android:endY="80"
                android:startColor="#FF758F"
                android:centerColor="#9D3BE8"
                android:endColor="#4B7BF5" />
        </aapt:attr>
    </path>

    <!-- Curved Glossy Specular Highlight along apex -->
    <path
        android:pathData="M 64,46 Q 74,52 68,57"
        android:strokeWidth="3.2"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="64"
                android:startY="46"
                android:endX="76"
                android:endY="54"
                android:startColor="#4DFFFFFF"
                android:endColor="#00FFFFFF" />
        </aapt:attr>
    </path>

    <!-- Curved Glossy Specular Highlight along vertical bar -->
    <path
        android:pathData="M 34,45 Q 36,52 34,58"
        android:strokeWidth="3.2"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="34"
                android:startY="45"
                android:endX="36"
                android:endY="58"
                android:startColor="#66FFFFFF"
                android:endColor="#00FFFFFF" />
        </aapt:attr>
    </path>
</vector>
