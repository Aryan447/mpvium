<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="320dp"
    android:height="180dp"
    android:viewportWidth="320"
    android:viewportHeight="180">

    <!-- Dark cinematic obsidian background -->
    <path
        android:pathData="M 0,0 L 320,0 L 320,180 L 0,180 Z"
        android:fillColor="#0D0E12" />

    <!-- Ambient glow centered behind mark -->
    <path
        android:pathData="M 40,0 L 280,0 L 280,180 L 40,180 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="160"
                android:centerY="90"
                android:gradientRadius="130"
                android:startColor="#2D8A2BE2"
                android:endColor="#00000000" />
        </aapt:attr>
    </path>

    <!-- Top filmstrip light horizon accent -->
    <path
        android:pathData="M 0,0 L 320,0 L 320,3 L 0,3 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="320"
                android:endY="0"
                android:startColor="#FF416C"
                android:centerColor="#8A2BE2"
                android:endColor="#00D2FF" />
        </aapt:attr>
    </path>

    <!-- Official mpvium play glyph, centered vertically and horizontally -->
    <group
        android:scaleX="0.17"
        android:scaleY="0.17"
        android:translateX="119.6"
        android:translateY="39">
        <!-- Soft shadow -->
        <path
            android:pathData="M 0.00,113.97 L 0.00,502.03 A 60.00,60.00 0 0,0 90.87,553.48 L 414.25,359.45 A 60.00,60.00 0 0,0 414.25,256.55 L 90.87,62.52 A 60.00,60.00 0 0,0 0.00,113.97 Z"
            android:fillColor="#33000000" />

        <!-- Gradient Play Glyph -->
        <path
            android:pathData="M 0.00,105.97 L 0.00,494.03 A 60.00,60.00 0 0,0 90.87,545.48 L 414.25,351.45 A 60.00,60.00 0 0,0 414.25,248.55 L 90.87,54.52 A 60.00,60.00 0 0,0 0.00,105.97 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="linear"
                    android:startX="0"
                    android:startY="50"
                    android:endX="450"
                    android:endY="550"
                    android:startColor="#FF416C"
                    android:centerColor="#8A2BE2"
                    android:endColor="#00D2FF" />
            </aapt:attr>
        </path>
    </group>
</vector>
